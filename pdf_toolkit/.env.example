# Flask application
FLASK_APP=pdf_toolkit.wsgi:app
FLASK_DEBUG=false

# Replace this placeholder with a unique secret in your local .env
SECRET_KEY=replace-with-a-random-secret

# Upload limits
MAX_CONTENT_LENGTH=26214400

# Optional application settings
HOST=127.0.0.1
PORT=5000

# Optional: directory for temporary files
# TEMP_DIR=./temp